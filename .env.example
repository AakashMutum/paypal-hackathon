# Copy to .env and fill in real values. Never commit .env.

# --- App config ---
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/checkout_guardian

# --- Audit privacy ---
# 32-byte key (64 hex characters) used to encrypt persisted investigation JSON and payment-event
# detail with AES-256-GCM. Generate it locally and never commit it:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it, buyer PII is still redacted before persistence, but the audit JSON is not encrypted.
AUDIT_ENCRYPTION_KEY=
# During key rotation only: the old key. Used to decrypt, never to encrypt. Remove it after
# `npm run audit:rotate -- --apply` has run and the dry run shows nothing left. See docs/key-rotation.md.
# AUDIT_ENCRYPTION_KEY_PREVIOUS=
# Optional separate HMAC key for the stored payee-email fingerprint. Falls back to
# AUDIT_ENCRYPTION_KEY, then to a plain SHA-256 fingerprint. Set it to the current key value
# BEFORE rotating, or pending orders will not match their stored fingerprint (docs/key-rotation.md).
# AUDIT_HMAC_KEY=

# --- PayPal (sandbox) ---
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret

# --- Merchant registry ---
# The API uses the local merchant_records table. No external corporate-registry provider is
# configured. Register merchants with POST /api/merchants, or add a provider adapter before
# relying on a commercial registry.

# --- India corporate registry (data.gov.in) ---
# Set the HTTPS resource URL for the "Registrars of Companies (RoC)-wise Company Master Data" dataset.
# The API key is used only by the API server and is sent to data.gov.in as its required api-key parameter.
# Provider rows are mapped into { records: [...] }; failures and no matches report UNKNOWN.
# CORPORATE_REGISTRY_URL=https://api.data.gov.in/resource/<resource-id>
# CORPORATE_REGISTRY_API_KEY=
# CORPORATE_REGISTRY_TIMEOUT_MS=2500

# --- Kernel ---
# Optional. Without it the API fetches the page over plain HTTP; JavaScript-heavy pages may be
# blocked or unavailable instead of being rendered.
KERNEL_API_KEY=

# --- Channel3 ---
# Optional. Without it price comparison is reported as PRICE_UNKNOWN/unavailable; no comparison
# is invented.
CHANNEL3_API_KEY=

# --- Elastic ---
# Optional. Without both, scam memory runs in the API process (or in a file, see MEMORY_MODE below).
# ELASTIC_URL=https://your-elastic-deployment.example
# ELASTIC_API_KEY=your_elastic_api_key

# --- LLM (optional — the agent uses deterministic fallbacks when unset) ---
# LLM_MODE: replay (answers recorded in LLM_FIXTURE_DIR, or the deterministic fallbacks when none are
# recorded), live (needs a key), record (live, and saves the answers) or none. Unset: live when a key
# is set, none otherwise. Never expose the key to the frontend.
LLM_MODE=replay
# To use a language model for follow-up investigation steps, name comparison, promotional-language
# reading and plain-language summaries, set LLM_MODE=live and a key. Gemini through its
# OpenAI-compatible endpoint:
# LLM_PROVIDER=gemini
# LLM_API_KEY=your_llm_api_key           # GEMINI_API_KEY is accepted as an alias
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL_FAST=gemini-3.5-flash
# LLM_MODEL_STRONG=gemini-3.5-flash
# Any other OpenAI-compatible provider: LLM_PROVIDER=openai-compatible, LLM_BASE_URL=https://api.openai.com/v1,
# LLM_MODEL_FAST=gpt-4o-mini, LLM_MODEL_STRONG=gpt-4o-mini
# LLM_FIXTURE_DIR=fixtures/llm  # override for record/replay mode

# --- Agent limits ---
AGENT_TIMEOUT_MS=45000
AGENT_MAX_FOLLOWUPS=3
# Total time all model calls of one scan may use. After it, remaining model steps are skipped and the
# deterministic output is used. 0 means no limit.
AGENT_MODEL_BUDGET_MS=1200
# Set FEATURE_PROMO_LANGUAGE=off to skip the promotional-language model read.
# FEATURE_PROMO_LANGUAGE=on
# Startup warm-up (a few harmless in-process calls). Set to off to disable.
# WARMUP=on
# Per-client request limit (defaults: 120 requests per 60000 ms).
# RATE_LIMIT_MAX=120
# RATE_LIMIT_WINDOW_MS=60000

# --- Scam memory (optional) ---
# MEMORY_MODE: elastic (needs ELASTIC_URL and ELASTIC_API_KEY), file, or memory. Unset: a local file
# when running normally. A file is lost when the host's disk is ephemeral (a free Render instance
# has no persistent disk), so set MEMORY_MODE=memory there, or mount a disk and point MEMORY_FILE at it.
# MEMORY_MODE=file
# MEMORY_FILE=.cache/trustora-memory.json
ELASTIC_INDEX=guardian-scam-memory
# ELASTIC_INFERENCE_ID=                # only needed for semantic_text pipelines

# --- Signals ---
# auto (default: recorded signals for the demo stores, live signals for any other domain),
# live, or replay (recorded signals only; unknown domains are reported as not checked).
# SIGNALS_MODE=auto

# --- Access control (API) ---
# Header x-demo-token for POST /api/demo/reset. Unset is refused in production.
DEMO_ADMIN_TOKEN=your_demo_admin_token
# When set, agent routes need Authorization: Bearer <this value>.
GUARDIAN_API_KEY=your_guardian_api_key

# --- scripts/smoke-deploy.mjs ---
# REQUIRE_AUDIT_ENCRYPTION=true makes the smoke test fail unless /health reports auditEncryption "enabled".

# --- Demo store payees (PayPal sandbox business accounts; see docs/paypal-sandbox.md) ---
STORE_GENUINE_PAYEE_EMAIL=
STORE_GENUINE_PAYEE_MERCHANT_ID=
STORE_DISCOUNT_PAYEE_EMAIL=
STORE_DISCOUNT_PAYEE_MERCHANT_ID=
STORE_IMPERSONATOR_PAYEE_EMAIL=
STORE_IMPERSONATOR_PAYEE_MERCHANT_ID=
