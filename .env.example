# Copy to .env and fill in real values. Never commit .env.

# --- App config ---
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/checkout_guardian

# --- Audit privacy ---
# 32-byte key (64 hex characters) used to encrypt persisted investigation JSON and payment-event
# detail with AES-256-GCM. Generate it locally and never commit it:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it, buyer PII is still redacted before persistence, but the audit JSON is not encrypted.
AUDIT_ENCRYPTION_KEY=
# Optional separate HMAC key for the stored payee-email fingerprint. Falls back to
# AUDIT_ENCRYPTION_KEY, then to a plain SHA-256 fingerprint.
# AUDIT_HMAC_KEY=

# --- PayPal (sandbox) ---
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_WEBHOOK_ID=your_paypal_sandbox_webhook_id

# --- Merchant registry ---
# The local merchant_records table is always used. Configure the optional corporate provider to
# look up merchants that are not in the local table. The provider must return the documented
# { records: [...] } JSON shape; absent/malformed/timeout responses fall back to local-only.
# CORPORATE_REGISTRY_URL=https://registry.example.com/lookup
# CORPORATE_REGISTRY_API_KEY=
# CORPORATE_REGISTRY_TIMEOUT_MS=2500

# --- Kernel ---
# Optional. Without it the API fetches the page over plain HTTP; JavaScript-heavy pages may be
# blocked or unavailable instead of being rendered.
KERNEL_API_KEY=

# --- Channel3 ---
# Optional. Without it price comparison is reported as PRICE_UNKNOWN/unavailable; no comparison
# is invented. CHANNEL3_BASE_URL is optional for a compatible proxy or test endpoint.
CHANNEL3_API_KEY=
# CHANNEL3_BASE_URL=https://api.trychannel3.com/v1/search

# --- Elastic ---
ELASTIC_URL=https://your-elastic-deployment.example
ELASTIC_API_KEY=your_elastic_api_key

# --- LLM (optional — the agent uses deterministic fallbacks when unset) ---
# Any OpenAI-compatible provider works. Gemini is wired with its OpenAI-compatible endpoint.
# The key may be supplied as LLM_API_KEY or GEMINI_API_KEY. Never expose it to the frontend.
LLM_MODE=live
LLM_PROVIDER=gemini
LLM_API_KEY=
# GEMINI_API_KEY=   # accepted as an alias for LLM_API_KEY
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL_FAST=gemini-3.5-flash
LLM_MODEL_STRONG=gemini-3.5-flash
# LLM_FIXTURE_DIR=fixtures/llm  # override for record/replay mode
AGENT_TIMEOUT_MS=45000
# Total budget for model calls. Slow providers fall back to deterministic template explanations;
# the deterministic decision is unchanged. Set 0 to disable the separate budget.
AGENT_MODEL_BUDGET_MS=1200
AGENT_MAX_FOLLOWUPS=3

# Validate contact/privacy/terms links on live pages with bounded, SSRF-safe fetches.
# Set false to skip the extra section requests.
VALIDATE_SECTION_PAGES=true

# --- Elastic memory (optional — falls back to in-memory store when unset) ---
ELASTIC_INDEX=guardian-scam-memory
# ELASTIC_INFERENCE_ID=                # only needed for semantic_text pipelines

# --- Signals ---
# auto (default: recorded signals for the demo stores, live signals for any other domain),
# live, or replay (recorded signals only; unknown domains are reported as not checked).
# SIGNALS_MODE=auto

# --- Access control (API) ---
# Header x-demo-token for POST /api/demo/reset. Unset is refused in production.
DEMO_ADMIN_TOKEN=your_demo_admin_token
# When set, agent routes need Authorization: Bearer <this value>.
GUARDIAN_API_KEY=your_guardian_api_key

# --- Demo store payees (PayPal sandbox business accounts; see docs/paypal-sandbox.md) ---
STORE_GENUINE_PAYEE_EMAIL=
STORE_GENUINE_PAYEE_MERCHANT_ID=
STORE_DISCOUNT_PAYEE_EMAIL=
STORE_DISCOUNT_PAYEE_MERCHANT_ID=
STORE_IMPERSONATOR_PAYEE_EMAIL=
STORE_IMPERSONATOR_PAYEE_MERCHANT_ID=
