# Copy to .env and fill in real values. Never commit .env.

# --- App config ---
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/checkout_guardian

# --- PayPal (sandbox) ---
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_WEBHOOK_ID=your_paypal_sandbox_webhook_id

# --- Kernel ---
KERNEL_API_KEY=your_kernel_api_key

# --- Channel3 ---
CHANNEL3_API_KEY=your_channel3_api_key

# --- Elastic ---
ELASTIC_URL=https://your-elastic-deployment.example
ELASTIC_API_KEY=your_elastic_api_key

# --- LLM ---
LLM_API_KEY=your_llm_api_key
