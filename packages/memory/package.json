{
  "name": "@checkout-guardian/memory",
  "version": "0.1.0",
  "private": true,
  "description": "Checkout Guardian memory module for entity history and risk indicators",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "index:create": "tsx scripts/create-index.ts"
  },
  "dependencies": {
    "@checkout-guardian/contracts": "*",
    "@elastic/elasticsearch": "^8.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
