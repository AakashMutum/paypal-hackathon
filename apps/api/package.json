{
  "name": "@TRUSTORA/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "pretest": "node -e \"import('node:fs').then(fs => { if (!fs.existsSync('node_modules/@TRUSTORA/contracts')) fs.cpSync('../../packages/contracts', 'node_modules/@TRUSTORA/contracts', { recursive: true }); })\"",
    "dev": "tsx watch src/server.ts",
    "build": "tsc && node -e \"import('node:fs').then(fs => { fs.cpSync('src/database/migrations', 'dist/src/database/migrations', { recursive: true }); })\"",
    "typecheck": "tsc --noEmit",
    "start": "node dist/src/server.js",
    "test:registry": "tsx --test test/corporateRegistry.test.ts",
    "test": "tsx --test test/database.config.test.ts test/database.health.test.ts test/database.migration.test.ts test/database.integration.test.ts test/health.test.ts",
    "migrate": "tsx src/database/migrate.ts",
    "migrate:status": "tsx src/database/migrate.ts --status"
  },
  "dependencies": {
    "@TRUSTORA/contracts": "*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}