NODE_ENV=development
HOST=0.0.0.0
PORT=3000
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/checkout_guardian
DATABASE_SSL=false
DATABASE_TIMEOUT_MS=2000
DATABASE_MAX_CONNECTIONS=10

# Audit privacy: 32-byte key (64 hex characters) for AES-256-GCM at rest.
# Generate locally with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it, buyer PII is still redacted but the audit JSON is not encrypted.
AUDIT_ENCRYPTION_KEY=
# Optional separate HMAC key for the payee-email fingerprint.
# AUDIT_HMAC_KEY=

# PayPal Sandbox Configuration
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_TIMEOUT_MS=10000

# Access control
DEMO_ADMIN_TOKEN=
GUARDIAN_API_KEY=

# How the agent runs: SIGNALS_MODE is replay, live or auto; LLM_MODE is replay, live, record or none.
# auto uses recorded signals for the canonical demo stores and live signals for other domains.
SIGNALS_MODE=auto
# replay uses recorded answers or the deterministic fallbacks. Set LLM_MODE=live and a key
# (LLM_API_KEY or GEMINI_API_KEY) to use Gemini or another OpenAI-compatible model.
LLM_MODE=replay
LLM_API_KEY=
# GEMINI_API_KEY=                 # accepted as an alias for LLM_API_KEY
KERNEL_API_KEY=
CHANNEL3_API_KEY=
# CHANNEL3_BASE_URL=https://api.trychannel3.com/v1/search
ELASTIC_URL=
ELASTIC_API_KEY=
AGENT_TIMEOUT_MS=45000
AGENT_MODEL_BUDGET_MS=1200
AGENT_MAX_FOLLOWUPS=3
VALIDATE_SECTION_PAGES=true

# Merchant identity uses the local merchant_records table first. The optional corporate provider
# is queried only when the local table has no record. Its response must match the documented
# { records: [...] } schema; failures fall back to local-only and never invent a merchant.
# CORPORATE_REGISTRY_URL=https://registry.example.com/lookup
# CORPORATE_REGISTRY_API_KEY=
# CORPORATE_REGISTRY_TIMEOUT_MS=2500

# Demo store payees (PayPal sandbox business accounts, see docs/paypal-sandbox.md)
STORE_GENUINE_PAYEE_EMAIL=
STORE_GENUINE_PAYEE_MERCHANT_ID=
STORE_DISCOUNT_PAYEE_EMAIL=
STORE_DISCOUNT_PAYEE_MERCHANT_ID=
STORE_IMPERSONATOR_PAYEE_EMAIL=
STORE_IMPERSONATOR_PAYEE_MERCHANT_ID=
