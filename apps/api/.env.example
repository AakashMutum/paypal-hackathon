NODE_ENV=development
HOST=0.0.0.0
PORT=3000
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/checkout_guardian
DATABASE_SSL=false
DATABASE_TIMEOUT_MS=2000
DATABASE_MAX_CONNECTIONS=10

# PayPal Sandbox Configuration
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_TIMEOUT_MS=10000

# Access control
DEMO_ADMIN_TOKEN=
GUARDIAN_API_KEY=

# How the agent runs: SIGNALS_MODE is replay, live or auto; LLM_MODE is replay, live or none.
SIGNALS_MODE=replay
LLM_MODE=none
LLM_API_KEY=
KERNEL_API_KEY=
CHANNEL3_API_KEY=
ELASTIC_URL=
ELASTIC_API_KEY=

# Demo store payees (PayPal sandbox business accounts, see docs/paypal-sandbox.md)
STORE_GENUINE_PAYEE_EMAIL=
STORE_GENUINE_PAYEE_MERCHANT_ID=
STORE_DISCOUNT_PAYEE_EMAIL=
STORE_DISCOUNT_PAYEE_MERCHANT_ID=
STORE_IMPERSONATOR_PAYEE_EMAIL=
STORE_IMPERSONATOR_PAYEE_MERCHANT_ID=
