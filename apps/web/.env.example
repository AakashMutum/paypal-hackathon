# The web app calls the API when VITE_API_URL is set and VITE_USE_MOCK is not "true".
# Otherwise it uses its built-in simulated backend (works offline).
# Public URL of the API, no trailing slash. Example for local development: http://localhost:3000
VITE_API_URL=
# Set to "true" to force the simulated backend even when VITE_API_URL is set.
VITE_USE_MOCK=
# Dev server proxy target for /api (only used by `npm run dev` when VITE_API_URL is empty).
VITE_API_TARGET=http://localhost:3000
# PayPal sandbox client id for the checkout button. Leave empty to use the simulated button.
VITE_PAYPAL_CLIENT_ID=
