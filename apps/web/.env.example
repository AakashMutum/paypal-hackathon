# VITE_USE_MOCK=false always calls the API. With an empty VITE_API_URL the web app uses
# same-origin requests, so the Vite dev proxy forwards /api to the backend.
# Leave both empty to use the built-in simulated backend (works offline).
# Public URL of the API without a trailing slash, for example http://localhost:3000.
VITE_API_URL=
# "false" forces the live API; "true" forces the simulated backend; empty uses the rules above.
VITE_USE_MOCK=
# Dev server proxy target for /api (only used by `npm run dev` when VITE_API_URL is empty).
VITE_API_TARGET=http://localhost:3000
# PayPal sandbox client id for the checkout button. Leave empty to use the simulated button.
VITE_PAYPAL_CLIENT_ID=
